# Copy to .env. Never commit real credentials.
# Generation / checker (OpenAI-compatible provider)
OPENAI_API_KEY=replace-with-your-key
OPENAI_MODEL=replace-with-your-model
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API=responses
# OPENAI_STRUCTURED_OUTPUT=strict
# OPENAI_CHAT_TOKEN_LIMIT_PARAM=max_completion_tokens
# CHECKER_API_KEY=replace-with-your-checker-key

# Optional MinerU PDF parsing (HTTP API)
# MINERU_API_KEY=replace-with-your-mineru-key

# Evaluation: only set variables referenced by the selected YAML api_key_env
# TYPESAFE_API_KEY=replace-with-your-jev-key
# OPENROUTER_API_KEY=replace-with-your-openrouter-key
# CHAT_API_KEY=replace-with-your-chat-provider-key
