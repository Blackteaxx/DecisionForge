{
  "name": "@decisionforge/dsh-plugin",
  "version": "0.3.0",
  "description": "DecisionForge branding and usage guide for DeepSeek Harness",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24.9.0",
    "dsh": "0.2.2-rc.1"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "locale",
    "docs"
  ],
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test",
    "start": "node scripts/start.mjs",
    "prepack": "npm run build",
    "register": "npm run build && node scripts/register.mjs"
  },
  "devDependencies": {
    "esbuild": "0.25.12",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "icon": "./lib/logo.png",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Blackteaxx/DecisionForge.git",
    "directory": "extensions/dsh-decisionforge"
  }
}
