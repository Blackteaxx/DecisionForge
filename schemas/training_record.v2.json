                                    {
                                        "type": "string"
                                    },
                                    {
                                        "additionalProperties": {
                                            "$ref": "#/$defs/JsonValue"
                                        },
                                        "type": "object"
                                    },
                                    {
                                        "items": {
                                            "$ref": "#/$defs/JsonValue"
                                        },
                                        "type": "array"
                                    }
                                ]
